DISCORD_BOT_TOKEN=your-bot-token
# Optional: set this while developing so slash commands sync instantly to one
# server instead of up to an hour for global commands.
DISCORD_GUILD_ID=

# Same Supabase project as the web app (see ../.env.example).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed (or local) web app, used to build plan links.
SYNC_APP_URL=http://localhost:3000
